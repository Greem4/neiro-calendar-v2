<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="3" author="Greem4">
        <addColumn tableName="attendance_records">
            <column name="user_id" type="BIGINT"/>
        </addColumn>

        <sql>
            UPDATE attendance_records
            SET user_id = 1
            WHERE user_id IS NULL;
        </sql>

        <addNotNullConstraint tableName="attendance_records" columnName="user_id" columnDataType="BIGINT"/>

        <addForeignKeyConstraint
                baseTableName="attendance_records"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_attendance_user"
                onDelete="CASCADE"/>

        <createIndex tableName="attendance_records" indexName="idx_attendance_user_date">
            <column name="user_id"/>
            <column name="visit_date"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
